# syntax=docker/dockerfile:1.7
# Estende o candidato exato; esta imagem de ferramentas nunca é publicada.
ARG RUNTIME_IMAGE
FROM ${RUNTIME_IMAGE}
USER root
RUN python -c 'import json; from importlib.metadata import distributions; from pathlib import Path; Path("/runtime-dependencies.json").write_text(json.dumps({d.metadata["Name"]:d.version for d in distributions()}))'
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml uv.lock README.md ./
RUN python -m ensurepip --upgrade && python -m pip install --no-cache-dir uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv
RUN --mount=type=cache,target=/root/.cache/uv uv sync --locked --no-editable --extra dev
COPY tests ./tests
COPY compose.yaml ./
ENV RUFF_CACHE_DIR=/tmp/ruff-cache PYTEST_ADDOPTS="-o cache_dir=/tmp/pytest-cache"
USER mega_sena
ENTRYPOINT []
CMD ["sh", "-c", "ruff check . && mypy && pytest"]
